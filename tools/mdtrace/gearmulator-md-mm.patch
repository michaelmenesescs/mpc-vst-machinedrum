 #include "mc68k/hdi08.h"
 #include "synthLib/realtimeInstrumentation.h"
 
+// --- MD_TRACE instrumentation (mpc-vst-machinedrum, not upstream): logs every UC<->DSP
+// HI08 word and host-command IRQ to stderr when MD_TRACE=1 is set. Local investigation only.
+#include <cstdio>
+#include <cstdlib>
+namespace md { bool g_mdTraceOn = false; }
+namespace dsp56k { extern void (*g_hostDmaWriteHook)(const DSP&, EMemArea, TWord, TWord); }
+namespace
+{
+	const dsp56k::DSP* g_traceDsps[2] = {nullptr, nullptr};
+	void hostDmaWriteTrace(const dsp56k::DSP& _dsp, const dsp56k::EMemArea _area, const dsp56k::TWord _addr, const dsp56k::TWord _value)
+	{
+		const bool on = std::getenv("MD_TRACE") != nullptr || md::g_mdTraceOn;
+		if(!on) return;
+		const int idx = &_dsp == g_traceDsps[0] ? 0 : &_dsp == g_traceDsps[1] ? 1 : -1;
+		std::fprintf(stderr, "DMA dsp%d %c:%06x=%06x cycle=%llu\n", idx, "PXYL"[_area], _addr, _value,
+			static_cast<unsigned long long>(_dsp.getCycles()));
+	}
+}
+namespace { bool mdTraceEnabled() { static const bool e = std::getenv("MD_TRACE") != nullptr; return e || md::g_mdTraceOn; } }
+namespace {
+	struct TraceCounters { unsigned boot=0, ucToDsp=0, dspToUc=0, irq=0; ~TraceCounters(){ std::fprintf(stderr, "MD_TRACE counters: boot=%u ucToDsp=%u dspToUc=%u irq=%u\n", boot, ucToDsp, dspToUc, irq); } };
+	TraceCounters g_traceCounters;
+}
+
